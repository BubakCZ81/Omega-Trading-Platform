//@version=6
strategy("Supertrend Trend-Following Strategy", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.05)

atrPeriod = input.int(10, "ATR Period")
src = input.source(hl2, "Source")
multiplier = input.float(3.0, "Supertrend Multiplier", step = 0.1)

atr = ta.atr(atrPeriod)
upperBand = src + (multiplier * atr)
lowerBand = src - (multiplier * atr)

var float prevLowerBand = 0.0
var float prevUpperBand = 0.0
var int direction = 1

lowerBand := lowerBand > prevLowerBand or close[1] < prevLowerBand ? lowerBand : prevLowerBand
upperBand := upperBand < prevUpperBand or close[1] > prevUpperBand ? upperBand : prevUpperBand

if (atr[1] == 0)
    direction := 1
else if (prevUpperBand == prevUpperBand[1] and direction[1] == -1 and close > upperBand)
    direction := 1
else if (prevLowerBand == prevLowerBand[1] and direction[1] == 1 and close < lowerBand)
    direction := -1
else
    direction := direction[1]

superTrend = direction == 1 ? lowerBand : upperBand
prevLowerBand := lowerBand
prevUpperBand := upperBand

longCondition = direction == 1 and direction[1] == -1
shortCondition = direction == -1 and direction[1] == 1

if (longCondition)
    strategy.entry("Supertrend Long", strategy.long)

if (shortCondition)
    strategy.entry("Supertrend Short", strategy.short)

plot(superTrend, "Supertrend", color = direction == 1 ? color.green : color.red, linewidth = 2)
